set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_ASM_COMPILER_FORCED TRUE)

set(ARM_GCC_PREFIX "arm-none-eabi" CACHE STRING "GNU Arm toolchain prefix")
find_program(CMAKE_C_COMPILER ${ARM_GCC_PREFIX}-gcc REQUIRED)
find_program(CMAKE_ASM_COMPILER ${ARM_GCC_PREFIX}-gcc REQUIRED)
find_program(CMAKE_AR ${ARM_GCC_PREFIX}-ar REQUIRED)
find_program(CMAKE_OBJCOPY ${ARM_GCC_PREFIX}-objcopy REQUIRED)
find_program(CMAKE_SIZE ${ARM_GCC_PREFIX}-size REQUIRED)

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
